<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Ui"
             x:Class="Ui.MainPage"
             Title="Студентські гуртки та семінари"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#120F18">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Window">#120F18</Color>
            <Color x:Key="Sidebar">#17121F</Color>
            <Color x:Key="Header">#191322</Color>
            <Color x:Key="CardBg">#1D1727</Color>
            <Color x:Key="CardBorder">#2E2540</Color>
            <Color x:Key="Field">#221B2E</Color>
            <Color x:Key="Text">#EFE8F5</Color>
            <Color x:Key="TextDim">#9A8CAE</Color>
            <Color x:Key="Accent">#E8A9CE</Color>
            <Color x:Key="Accent2">#B9A3E3</Color>
            <Color x:Key="AccentSoft">#2EE8A9CE</Color>
            <Color x:Key="Accent2Soft">#2EB9A3E3</Color>
            <Color x:Key="ButtonBg">#2A2138</Color>
            <Color x:Key="Danger">#F09AAE</Color>

            <!-- Implicit styles: they apply to every element of the type on this page -->
            <Style TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource Text}" />
            </Style>

            <!-- Without it the app-wide style draws a grey frame around badges and tags -->
            <Style TargetType="Border">
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Stroke" Value="Transparent" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="HeightRequest" Value="34" />
                <Setter Property="MinimumHeightRequest" Value="0" />
                <Setter Property="MinimumWidthRequest" Value="0" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="BackgroundColor" Value="{StaticResource ButtonBg}" />
                <Setter Property="TextColor" Value="{StaticResource Text}" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource Text}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextDim}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- Buttons -->
            <Style x:Key="AccentButton" TargetType="Button">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Padding" Value="20,0" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="MinimumHeightRequest" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                <Setter Property="TextColor" Value="{StaticResource Window}" />
            </Style>

            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="MinimumHeightRequest" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="BorderColor" Value="{StaticResource CardBorder}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource Text}" />
            </Style>

            <Style x:Key="SmallButton" TargetType="Button">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="HeightRequest" Value="30" />
                <Setter Property="MinimumHeightRequest" Value="0" />
                <Setter Property="MinimumWidthRequest" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="BackgroundColor" Value="{StaticResource ButtonBg}" />
                <Setter Property="TextColor" Value="{StaticResource Text}" />
            </Style>

            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="WidthRequest" Value="26" />
                <Setter Property="HeightRequest" Value="26" />
                <Setter Property="MinimumHeightRequest" Value="0" />
                <Setter Property="MinimumWidthRequest" Value="0" />
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="BackgroundColor" Value="{StaticResource ButtonBg}" />
                <Setter Property="TextColor" Value="{StaticResource TextDim}" />
                <Setter Property="VerticalOptions" Value="Start" />
            </Style>

            <Style x:Key="DangerButton" TargetType="Button">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HeightRequest" Value="36" />
                <Setter Property="MinimumHeightRequest" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="BorderColor" Value="{StaticResource Danger}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource Danger}" />
            </Style>

            <!-- Text -->
            <Style x:Key="Section" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1.4" />
                <Setter Property="TextColor" Value="{StaticResource TextDim}" />
            </Style>

            <Style x:Key="Hint" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource TextDim}" />
            </Style>

            <!-- Cards and fields -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource CardBg}" />
                <Setter Property="Stroke" Value="{StaticResource CardBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <Style x:Key="FileCard" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource CardBg}" />
                <Setter Property="Stroke" Value="{StaticResource CardBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <Style x:Key="FileBadge" TargetType="Border">
                <Setter Property="WidthRequest" Value="42" />
                <Setter Property="HeightRequest" Value="42" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="FileBadgeText" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="FileName" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource Text}" />
                <Setter Property="LineBreakMode" Value="MiddleTruncation" />
            </Style>

            <Style x:Key="FileInfo" TargetType="Label">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="TextColor" Value="{StaticResource TextDim}" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <Style x:Key="FieldFrame" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Field}" />
                <Setter Property="Stroke" Value="{StaticResource CardBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HeightRequest" Value="40" />
            </Style>

            <!-- Segmented switches: the analysis method and where to save -->
            <Style x:Key="Segments" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Field}" />
                <Setter Property="Stroke" Value="{StaticResource CardBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Padding" Value="4" />
            </Style>

            <Style x:Key="Tile" TargetType="Border">
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 9" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <Style x:Key="TileTitle" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="TileCaption" TargetType="Label">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <!-- Results -->
            <Style x:Key="Badge" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource AccentSoft}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 11" />
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="ResultCard" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource CardBg}" />
                <Setter Property="Stroke" Value="{StaticResource CardBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                <Setter Property="Padding" Value="16,14" />
            </Style>

            <Style x:Key="Chip" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource ButtonBg}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 7" />
                <Setter Property="Padding" Value="9,4" />
                <Setter Property="Margin" Value="0,0,6,6" />
            </Style>

            <Style x:Key="ChipText" TargetType="Label">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="TextColor" Value="{StaticResource TextDim}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="290,1,*">

        <!-- ===== Sidebar: files, where to save, tools ===== -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" RowSpacing="20" Padding="20,22,20,18"
              BackgroundColor="{StaticResource Sidebar}">

            <!-- Brand -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border WidthRequest="42" HeightRequest="42" StrokeShape="RoundRectangle 12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#E8A9CE" Offset="0" />
                            <GradientStop Color="#B9A3E3" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Label Text="SC" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Window}"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label Text="StudentClubs" FontSize="16" FontAttributes="Bold" />
                    <Label Text="гуртки та семінари · XML" Style="{StaticResource Hint}" FontSize="11.5" />
                </VerticalStackLayout>
            </Grid>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="10">

                    <Label Text="ДЖЕРЕЛА ДАНИХ" Style="{StaticResource Section}" />

                    <!-- XML: the clubs that are searched -->
                    <Border Style="{StaticResource FileCard}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border Style="{StaticResource FileBadge}" BackgroundColor="{StaticResource AccentSoft}">
                                    <Label Text="XML" Style="{StaticResource FileBadgeText}" TextColor="{StaticResource Accent}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label x:Name="XmlFileLabel" Text="Файл не відкрито" Style="{StaticResource FileName}" />
                                    <Label x:Name="XmlInfoLabel" Text="Гуртки, серед яких іде пошук" Style="{StaticResource FileInfo}" />
                                </VerticalStackLayout>
                                <Button x:Name="CloseXmlButton" Grid.Column="2" Text="✕" Style="{StaticResource IconButton}"
                                        IsVisible="False" Clicked="OnCloseXmlClicked" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Grid.Column="0" Text="З диска" Style="{StaticResource SmallButton}"
                                        CommandParameter="Local" Clicked="OnOpenXmlClicked" />
                                <Button Grid.Column="1" Text="З Drive" Style="{StaticResource SmallButton}"
                                        CommandParameter="GoogleDrive" Clicked="OnOpenXmlClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- XSL: the look of the HTML page -->
                    <Border Style="{StaticResource FileCard}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border Style="{StaticResource FileBadge}" BackgroundColor="{StaticResource Accent2Soft}">
                                    <Label Text="XSL" Style="{StaticResource FileBadgeText}" TextColor="{StaticResource Accent2}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label x:Name="XslFileLabel" Text="Файл не відкрито" Style="{StaticResource FileName}" />
                                    <Label x:Name="XslInfoLabel" Text="Шаблон для HTML-сторінки" Style="{StaticResource FileInfo}" />
                                </VerticalStackLayout>
                                <Button x:Name="CloseXslButton" Grid.Column="2" Text="✕" Style="{StaticResource IconButton}"
                                        IsVisible="False" Clicked="OnCloseXslClicked" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Grid.Column="0" Text="З диска" Style="{StaticResource SmallButton}"
                                        CommandParameter="Local" Clicked="OnOpenXslClicked" />
                                <Button Grid.Column="1" Text="З Drive" Style="{StaticResource SmallButton}"
                                        CommandParameter="GoogleDrive" Clicked="OnOpenXslClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="КУДИ ЗБЕРІГАТИ" Style="{StaticResource Section}" Margin="0,14,0,0" />

                    <Border Style="{StaticResource Segments}">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                            <Border x:Name="LocalTile" Grid.Column="0" Style="{StaticResource Tile}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="Local" Tapped="OnTargetChanged" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="Локально" Style="{StaticResource TileTitle}" />
                                    <Label Text="папка Results" Style="{StaticResource TileCaption}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border x:Name="DriveTile" Grid.Column="1" Style="{StaticResource Tile}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="GoogleDrive" Tapped="OnTargetChanged" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="Google Drive" Style="{StaticResource TileTitle}" />
                                    <Label Text="Мій диск" Style="{StaticResource TileCaption}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource FieldFrame}">
                        <Entry x:Name="FileNameEntry" Text="clubs_result" Placeholder="Назва файлу" />
                    </Border>
                    <Label Text="Розширення .xml або .html програма додає сама" Style="{StaticResource Hint}" FontSize="11.5" />

                </VerticalStackLayout>
            </ScrollView>

            <!-- Tools and exit stay at the bottom -->
            <VerticalStackLayout Grid.Row="2" Spacing="8">
                <Label Text="ІНСТРУМЕНТИ" Style="{StaticResource Section}" />
                <Button Text="Протокол подій" Style="{StaticResource GhostButton}" HeightRequest="36"
                        Clicked="OnOpenLogClicked" />
                <Label x:Name="LogPathLabel" Style="{StaticResource Hint}" FontSize="10.5"
                       LineBreakMode="HeadTruncation" />
                <Button Text="Вийти з програми" Style="{StaticResource DangerButton}" Margin="0,8,0,0"
                        Clicked="OnExitClicked" />
            </VerticalStackLayout>
        </Grid>

        <BoxView Grid.Column="1" Color="{StaticResource CardBorder}" />

        <!-- ===== Main area ===== -->
        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="18" Padding="28,22,28,18">

            <!-- Title and the analysis method -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="20">
                <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="End">
                    <Label Text="Пошук гуртків і семінарів" FontSize="24" FontAttributes="Bold" />
                    <Label Text="Оберіть параметри, і результат оновиться одразу" Style="{StaticResource Hint}" FontSize="13" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Label Text="СПОСІБ АНАЛІЗУ" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource Segments}" WidthRequest="372">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                            <Border x:Name="SaxTile" Grid.Column="0" Style="{StaticResource Tile}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="Sax" Tapped="OnMethodChanged" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="SAX API" Style="{StaticResource TileTitle}" />
                                    <Label Text="потокове читання" Style="{StaticResource TileCaption}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border x:Name="DomTile" Grid.Column="1" Style="{StaticResource Tile}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="Dom" Tapped="OnMethodChanged" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="DOM API" Style="{StaticResource TileTitle}" />
                                    <Label Text="дерево + XPath" Style="{StaticResource TileCaption}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border x:Name="LinqTile" Grid.Column="2" Style="{StaticResource Tile}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer CommandParameter="Linq" Tapped="OnMethodChanged" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="LINQ to XML" Style="{StaticResource TileTitle}" />
                                    <Label Text="запити LINQ" Style="{StaticResource TileCaption}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!-- Search parameters: the lists are filled with the values found in the opened file -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="ПАРАМЕТРИ ПОШУКУ" Style="{StaticResource Section}" />
                        <Label Grid.Column="1" Text="значення взято з відкритого XML-файлу" Style="{StaticResource Hint}" FontSize="11.5" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <local:ValueSelector x:Name="KindSelector" Grid.Row="0" Grid.Column="0"
                                             Caption="Вид" Placeholder="будь-який" />
                        <local:ValueSelector x:Name="FacultySelector" Grid.Row="0" Grid.Column="1"
                                             Caption="Факультет" Placeholder="будь-який" />
                        <local:ValueSelector x:Name="DepartmentSelector" Grid.Row="0" Grid.Column="2"
                                             Caption="Кафедра" Placeholder="будь-яка" />
                        <local:ValueSelector x:Name="DaySelector" Grid.Row="1" Grid.Column="0"
                                             Caption="День засідань" Placeholder="будь-який" />
                        <local:ValueSelector x:Name="CourseSelector" Grid.Row="1" Grid.Column="1"
                                             Caption="Курс" Placeholder="будь-який" />
                        <local:ValueSelector x:Name="TopicSelector" Grid.Row="1" Grid.Column="2"
                                             Caption="Тематика" Placeholder="будь-яка" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" Style="{StaticResource FieldFrame}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <!-- A magnifier drawn with lines, so it looks the same with any font -->
                                <Path Grid.Column="0" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"
                                      Data="M13,7.5 A5.5,5.5 0 1,1 2,7.5 A5.5,5.5 0 1,1 13,7.5 M11.5,11.5 L16,16"
                                      Stroke="{StaticResource TextDim}" StrokeThickness="1.8" StrokeLineCap="Round" />
                                <Entry x:Name="KeywordEntry" Grid.Column="1"
                                       Placeholder="Ключове слово (назва, староста, керівник...)"
                                       TextChanged="OnKeywordChanged" Completed="OnKeywordCompleted" />
                            </Grid>
                        </Border>
                        <Button Grid.Column="1" Text="Пошук" Style="{StaticResource AccentButton}" Clicked="OnSearchClicked" />
                        <Button Grid.Column="2" Text="Очистити" Style="{StaticResource GhostButton}" Clicked="OnClearClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Results heading, the actions with them and the XPath of the last DOM search -->
            <VerticalStackLayout Grid.Row="2" Spacing="10">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                    <Label Grid.Column="0" Text="Результати" FontSize="19" FontAttributes="Bold" VerticalOptions="Center" />
                    <Border x:Name="CountBorder" Grid.Column="1" Style="{StaticResource Badge}" IsVisible="False">
                        <Label x:Name="CountLabel" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
                    </Border>
                    <Label x:Name="MethodLabel" Grid.Column="2" Style="{StaticResource Hint}" VerticalOptions="Center" />
                    <Button Grid.Column="4" Text="Зберегти XML" Style="{StaticResource GhostButton}" HeightRequest="36"
                            Clicked="OnSaveXmlClicked" />
                    <Button Grid.Column="5" Text="Трансформувати в HTML" HeightRequest="36"
                            Clicked="OnTransformClicked" />
                </Grid>

                <Border x:Name="QueryBorder" Style="{StaticResource Badge}" BackgroundColor="{StaticResource Accent2Soft}"
                        Padding="12,7" HorizontalOptions="Start" IsVisible="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="XPATH" FontSize="10.5" FontAttributes="Bold" CharacterSpacing="1.2"
                               TextColor="{StaticResource Accent2}" VerticalOptions="Center" />
                        <Label x:Name="QueryLabel" Grid.Column="1" FontFamily="Menlo" FontSize="12"
                               TextColor="{StaticResource Text}" LineBreakMode="WordWrap" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Result cards; the dashed frame with a hint is shown while there is nothing to show -->
            <Grid Grid.Row="3">
                <ScrollView>
                    <VerticalStackLayout x:Name="ResultsList" Spacing="10" Padding="0,0,6,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:ClubCard">
                                <Border Style="{StaticResource ResultCard}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                                        <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" VerticalOptions="Start"
                                                StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource AccentSoft}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSeminar}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Accent2Soft}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding Initial}" FontSize="18" FontAttributes="Bold"
                                                   TextColor="{StaticResource Accent}"
                                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSeminar}" Value="True">
                                                        <Setter Property="TextColor" Value="{StaticResource Accent2}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" />
                                            <Label Text="{Binding Faculty}" FontSize="12.5" TextColor="{StaticResource Accent}" />
                                            <Label FontSize="12" LineBreakMode="WordWrap">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Староста " TextColor="{StaticResource TextDim}" />
                                                        <Span Text="{Binding Head}" TextColor="{StaticResource Text}" />
                                                        <Span Text="     ·     " TextColor="{StaticResource TextDim}" />
                                                        <Span Text="Керівник " TextColor="{StaticResource TextDim}" />
                                                        <Span Text="{Binding Supervisor}" TextColor="{StaticResource Text}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start"
                                                        AlignItems="Start" AlignContent="Start" Margin="0,6,0,-6"
                                                        BindableLayout.ItemsSource="{Binding Chips}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border Style="{StaticResource Chip}">
                                                            <Label Text="{Binding .}" Style="{StaticResource ChipText}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </FlexLayout>
                                        </VerticalStackLayout>

                                        <Border Grid.Column="2" Style="{StaticResource Badge}" BackgroundColor="{StaticResource ButtonBg}"
                                                VerticalOptions="Start">
                                            <Label Text="{Binding Kind}" FontSize="11.5" TextColor="{StaticResource TextDim}" />
                                        </Border>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>

                <Border x:Name="EmptyBorder" VerticalOptions="Start" Padding="28,30"
                        Stroke="{StaticResource CardBorder}" StrokeThickness="1.5" StrokeDashArray="5,4"
                        StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="6">
                        <Label x:Name="EmptyTitleLabel" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label x:Name="EmptyHintLabel" Style="{StaticResource Hint}" FontSize="13"
                               HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Status: what the program has just done -->
            <Border Grid.Row="4" HorizontalOptions="Start" Padding="14,8" BackgroundColor="{StaticResource Header}"
                    Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Ellipse Grid.Column="0" WidthRequest="7" HeightRequest="7" Fill="{StaticResource Accent}"
                             VerticalOptions="Center" />
                    <Label x:Name="StatusLabel" Grid.Column="1" FontSize="12" TextColor="{StaticResource TextDim}"
                           LineBreakMode="TailTruncation" VerticalOptions="Center" />
                </Grid>
            </Border>

        </Grid>
    </Grid>
</ContentPage>
