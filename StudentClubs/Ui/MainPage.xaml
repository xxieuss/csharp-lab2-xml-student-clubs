<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Ui"
             x:Class="Ui.MainPage"
             Title="Студентські гуртки та семінари"
             BackgroundColor="#120F18">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Window">#120F18</Color>
            <Color x:Key="Header">#191322</Color>
            <Color x:Key="CardBg">#1D1727</Color>
            <Color x:Key="CardBorder">#2E2540</Color>
            <Color x:Key="Field">#221B2E</Color>
            <Color x:Key="Text">#EFE8F5</Color>
            <Color x:Key="TextDim">#9A8CAE</Color>
            <Color x:Key="Accent">#E8A9CE</Color>
            <Color x:Key="Accent2">#B9A3E3</Color>
            <Color x:Key="ButtonBg">#2A2138</Color>

            <Style TargetType="Button">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HeightRequest" Value="32" />
                <Setter Property="MinimumHeightRequest" Value="0" />
                <Setter Property="MinimumWidthRequest" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="BackgroundColor" Value="{StaticResource ButtonBg}" />
                <Setter Property="TextColor" Value="{StaticResource Text}" />
            </Style>

            <Style x:Key="AccentButton" TargetType="Button">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HeightRequest" Value="34" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                <Setter Property="TextColor" Value="{StaticResource Window}" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource CardBg}" />
                <Setter Property="Stroke" Value="{StaticResource CardBorder}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="Section" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1.4" />
                <Setter Property="TextColor" Value="{StaticResource TextDim}" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource TextDim}" />
            </Style>

            <Style x:Key="SmallButton" TargetType="Button">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="HeightRequest" Value="24" />
                <Setter Property="MinimumHeightRequest" Value="0" />
                <Setter Property="MinimumWidthRequest" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="BackgroundColor" Value="{StaticResource ButtonBg}" />
                <Setter Property="TextColor" Value="{StaticResource TextDim}" />
            </Style>

            <Style x:Key="FileName" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{StaticResource Accent2}" />
                <Setter Property="LineBreakMode" Value="MiddleTruncation" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="Rule" TargetType="BoxView">
                <Setter Property="HeightRequest" Value="1" />
                <Setter Property="Color" Value="{StaticResource CardBorder}" />
                <Setter Property="Margin" Value="0,6" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource Text}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextDim}" />
                <Setter Property="BackgroundColor" Value="{StaticResource Field}" />
            </Style>

            <Style TargetType="RadioButton">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource Text}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="18,12" BackgroundColor="{StaticResource Header}">
            <Label Grid.Column="0" Text="StudentClubs · обробка XML"
                   FontSize="19" FontAttributes="Bold" CharacterSpacing="0.5"
                   TextColor="{StaticResource Accent}" VerticalTextAlignment="Center" />
            <Button Grid.Column="1" Text="Вихід" Clicked="OnExitClicked" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="300,340,*" ColumnSpacing="14" Padding="14">

            <!-- Files, analysis method, saving -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <ScrollView>
                    <VerticalStackLayout Spacing="8">

                        <Label Text="XML-ФАЙЛ · ДАНІ" Style="{StaticResource Section}" />
                        <Label Text="Усі гуртки, серед яких іде пошук" Style="{StaticResource FieldLabel}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                            <Button Grid.Column="0" Text="З диска" CommandParameter="Local" Clicked="OnOpenXmlClicked" />
                            <Button Grid.Column="1" Text="З Google Drive" CommandParameter="GoogleDrive" Clicked="OnOpenXmlClicked" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <Label x:Name="XmlFileLabel" Grid.Column="0" Text="не відкрито" Style="{StaticResource FileName}" />
                            <Button x:Name="CloseXmlButton" Grid.Column="1" Text="Закрити" Style="{StaticResource SmallButton}"
                                    IsVisible="False" Clicked="OnCloseXmlClicked" />
                        </Grid>

                        <Label Text="XSL-ФАЙЛ · ШАБЛОН" Style="{StaticResource Section}" Margin="0,6,0,0" />
                        <Label Text="Задає вигляд HTML-сторінки. Потрібен лише для «Трансформувати в HTML»" Style="{StaticResource FieldLabel}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                            <Button Grid.Column="0" Text="З диска" CommandParameter="Local" Clicked="OnOpenXslClicked" />
                            <Button Grid.Column="1" Text="З Google Drive" CommandParameter="GoogleDrive" Clicked="OnOpenXslClicked" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <Label x:Name="XslFileLabel" Grid.Column="0" Text="не відкрито" Style="{StaticResource FileName}" />
                            <Button x:Name="CloseXslButton" Grid.Column="1" Text="Закрити" Style="{StaticResource SmallButton}"
                                    IsVisible="False" Clicked="OnCloseXslClicked" />
                        </Grid>

                        <BoxView Style="{StaticResource Rule}" />

                        <Label Text="СПОСІБ АНАЛІЗУ" Style="{StaticResource Section}" />
                        <RadioButton x:Name="SaxRadio" Content="SAX API" Value="Sax" GroupName="Method"
                                     IsChecked="True" CheckedChanged="OnMethodChanged" />
                        <RadioButton x:Name="DomRadio" Content="DOM API" Value="Dom" GroupName="Method"
                                     CheckedChanged="OnMethodChanged" />
                        <RadioButton x:Name="LinqRadio" Content="LINQ to XML" Value="Linq" GroupName="Method"
                                     CheckedChanged="OnMethodChanged" />

                        <BoxView Style="{StaticResource Rule}" />

                        <Label Text="ЗБЕРЕЖЕННЯ РЕЗУЛЬТАТУ" Style="{StaticResource Section}" />
                        <RadioButton x:Name="LocalTargetRadio" Content="Локальний диск" GroupName="Target" IsChecked="True" />
                        <RadioButton x:Name="DriveTargetRadio" Content="Google Drive" GroupName="Target" />
                        <Label Text="Назва файлу (без розширення)" Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="FileNameEntry" Text="clubs_result" />
                        <Button Text="Зберегти як XML" Clicked="OnSaveXmlClicked" />
                        <Button Text="Трансформувати в HTML" Clicked="OnTransformClicked" />

                    </VerticalStackLayout>
                </ScrollView>
            </Border>

            <!-- Search parameters: the lists are filled with the values found in the opened file;
                 every change refreshes the results at once -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollView>
                    <VerticalStackLayout Spacing="6">

                        <Label Text="ПАРАМЕТРИ ПОШУКУ" Style="{StaticResource Section}" />

                        <Label Text="Вид" Style="{StaticResource FieldLabel}" />
                        <local:ValueSelector x:Name="KindSelector" Placeholder="будь-який" />

                        <Label Text="Факультет" Style="{StaticResource FieldLabel}" />
                        <local:ValueSelector x:Name="FacultySelector" Placeholder="будь-який" />

                        <Label Text="Кафедра" Style="{StaticResource FieldLabel}" />
                        <local:ValueSelector x:Name="DepartmentSelector" Placeholder="будь-яка" />

                        <Label Text="День засідань" Style="{StaticResource FieldLabel}" />
                        <local:ValueSelector x:Name="DaySelector" Placeholder="будь-який" />

                        <Label Text="Курс" Style="{StaticResource FieldLabel}" />
                        <local:ValueSelector x:Name="CourseSelector" Placeholder="будь-який" />

                        <Label Text="Тематика" Style="{StaticResource FieldLabel}" />
                        <local:ValueSelector x:Name="TopicSelector" Placeholder="будь-яка" />

                        <Label Text="Ключове слово (назва, староста, керівник...)" Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="KeywordEntry" Placeholder="наприклад, олімп"
                               TextChanged="OnKeywordChanged" Completed="OnKeywordCompleted" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,10,0,0">
                            <Button Grid.Column="0" Text="Пошук" Style="{StaticResource AccentButton}" Clicked="OnSearchClicked" />
                            <Button Grid.Column="1" Text="Очистити" Clicked="OnClearClicked" />
                        </Grid>

                    </VerticalStackLayout>
                </ScrollView>
            </Border>

            <!-- Output -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                    <Label x:Name="ResultsTitleLabel" Grid.Row="0" Text="РЕЗУЛЬТАТИ" Style="{StaticResource Section}" />
                    <Label x:Name="QueryLabel" Grid.Row="1" IsVisible="False"
                           FontSize="12" FontFamily="Menlo" TextColor="{StaticResource Accent2}"
                           LineBreakMode="WordWrap" />
                    <ScrollView Grid.Row="2">
                        <Label x:Name="ResultsLabel" FontSize="13" LineHeight="1.3"
                               TextColor="{StaticResource Text}" />
                    </ScrollView>
                </Grid>
            </Border>

        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="18,9" BackgroundColor="{StaticResource Header}">
            <Label x:Name="StatusLabel" Grid.Column="0" FontSize="12"
                   TextColor="{StaticResource TextDim}" VerticalTextAlignment="Center" />
            <Label x:Name="LogPathLabel" Grid.Column="1" FontSize="12" LineBreakMode="HeadTruncation"
                   MaximumWidthRequest="520"
                   TextColor="{StaticResource TextDim}" VerticalTextAlignment="Center" />
        </Grid>

    </Grid>
</ContentPage>
